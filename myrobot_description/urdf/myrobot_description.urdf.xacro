<?xml version="1.0"?>
<robot name="myrobot_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments to configure the robot behavior -->
  <xacro:arg name="use_mock_hardware" default="true" />

  <!-- 1. Include the geometric description macro of the manipulator arm -->
  <xacro:include filename="$(find myrobot_description)/urdf/myrobot_geometry.urdf.xacro" />

  <!-- 2. Instantiate the standalone arm with root link 'base_link' -->
  <xacro:myrobot_arm base_link_name="base_link" parent="">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </xacro:myrobot_arm>

  <!-- 3. Include and instantiate the ros2_control configuration -->
  <xacro:include filename="$(find myrobot_description)/urdf/myrobot.ros2_control.xacro" />
  <xacro:myrobot_ros2_control name="FakeSystem" use_mock_hardware="$(arg use_mock_hardware)" />

</robot>
